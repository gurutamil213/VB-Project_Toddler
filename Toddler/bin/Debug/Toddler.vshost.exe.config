<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
    </configSections>
    <connectionStrings>
        <add name="Toddler.My.MySettings.todd1ConnectionString" connectionString="Provider=Microsoft.ACE.OLEDB.12.0;Data Source=|DataDirectory|\todd1.accdb"
            providerName="System.Data.OleDb" />
        <add name="Toddler.My.MySettings.toddlerConnectionString" connectionString="Provider=Microsoft.ACE.OLEDB.12.0;Data Source=|DataDirectory|\toddler.accdb"
            providerName="System.Data.OleDb" />
    </connectionStrings>
    <appSettings>
        <add key="ToddlerLoginUsername" value="bala" />
        <add key="ToddlerLoginPassword" value="guru" />
    </appSettings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0,Profile=Client" />
    </startup>
</configuration>